[Unit]
Description=acme - TLS, the web address, the firewall, the network, the time, the console at login, the local users, the journal and the logs or PostgreSQL's log, SELinux, asked for on the pages

[Path]
PathExists=/var/lib/acme/web/request.json
PathExists=/var/lib/acme/web/pglog.ask
PathExists=/var/lib/acme/web/pgtls.ask
PathExists=/var/lib/acme/web/dbmake.ask
PathExists=/var/lib/acme/web/fw.ask
PathExists=/var/lib/acme/web/net.ask
PathExists=/var/lib/acme/web/ntp.ask
PathExists=/var/lib/acme/web/console.ask
PathExists=/var/lib/acme/web/sshkeys.ask
PathExists=/var/lib/acme/web/users.ask
PathExists=/var/lib/acme/web/osroots.ask
PathExists=/var/lib/acme/web/osup.ask
PathExists=/var/lib/acme/web/sshd.ask
PathExists=/var/lib/acme/web/logs.ask
PathExists=/var/lib/acme/web/selinux.ask
Unit=acme-web.service
TriggerLimitIntervalSec=0

[Install]
WantedBy=multi-user.target

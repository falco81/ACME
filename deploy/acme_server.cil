; acme - what SELinux needs for acme that the system's policy does not say (as otp 1.0.233).
; Installed by install.sh and by every upgrade (semodule -i acme_server.cil), taken away with
; semodule -r acme_server. Labels first; a narrow rule only where no label or boolean does it
; (systemd's /run/acme; 1.0.59: PostgreSQL reading the certificates' folder), each in a block
; of its own.
;
; /run/acme holds the daemon's API token and port. The pages (php-fpm, httpd_t) read them;
; made by systemd as var_run_t, httpd_t may not read it. Labelled as the web server's own
; run files, which httpd_t reads; the daemon (unconfined_service_t) writes it as before.
;
; Both spellings (as otp 1.0.234): the policy reads a path through file_contexts.subs_dist first -
; on RHEL 8 "/run" is looked up as "/var/run", on newer policies the other way round - so a
; rule for one of them alone may never be matched. The one never looked up does nothing.
(filecon "/run/acme" dir (system_u object_r httpd_var_run_t ((s0) (s0))))
(filecon "/run/acme/.*" any (system_u object_r httpd_var_run_t ((s0) (s0))))
(filecon "/var/run/acme" dir (system_u object_r httpd_var_run_t ((s0) (s0))))
(filecon "/var/run/acme/.*" any (system_u object_r httpd_var_run_t ((s0) (s0))))

; systemd hands /run/acme back to the service's account before every command of the unit -
; ExecReload too (`systemctl reload acme`): it may change the owner and the mode of what is in it
; (as otp 1.0.237). Under enforcing the reload failed - seen on a node in permissive as
; "init_t -> httpd_var_run_t file { setattr } (kill)". Only that: no read, no write. In a block
; of its own, so that a policy without one of the types still takes the rest of the module.
(optional acme_server_systemd_runtime
    (allow init_t httpd_var_run_t (dir (getattr setattr search open read)))
    (allow init_t httpd_var_run_t (file (getattr setattr))))

; The link between the databases of a cluster encrypted (1.0.59, as otp 1.0.265): the
; subscription's worker is PostgreSQL itself (postgresql_t), and libpq there reads the
; authorities named by sslrootcert - /etc/pki/acme/ha-ca.pem (or the system's bundle), cert_t.
; The targeted policy lets postgresql_t read cert_t only with authlogin_nsswitch_use_ldap on:
; under enforcing the worker fails with "could not read root certificate file ... Permission
; denied" and replication stops - "postgresql_t -> cert_t dir { search } / file { read open }".
; Read only: what miscfiles_read_generic_certs() gives other services. A key in /etc/pki stays
; root's 0600. Put in on a node without the pages (install.sh --no-web) too.
(optional acme_server_postgresql_certs
    (allow postgresql_t cert_t (dir (getattr search open read)))
    (allow postgresql_t cert_t (file (getattr open read ioctl lock)))
    (allow postgresql_t cert_t (lnk_file (getattr read))))

# /etc/systemd/system/acme.service
#
# The certificate manager: renewals and deployments on their schedule, its
# own DNS server for DNS-01 (UDP and TCP 53, once switched on), the API the
# web pages ask on 127.0.0.1:9861, and everything else. One process, its own
# account, and nothing it may write outside its own folders.
#
# It runs the tree /usr/local/lib/acme/current points to (install.sh switches
# that link in one step on an upgrade, and restarts this).
#
# What it calls: openssl (keys, CSRs, PKCS#12, its own CAs) and the OpenSSH
# client (targets and HTTP-01 over SSH, backups over SFTP/SCP) - outbound
# only. Its known_hosts and keys are in /var/lib/acme.
[Unit]
Description=acme - certificates kept, renewed and put in place (ACME, own CAs, DNS-01, deployments)
Documentation=file:/usr/local/lib/acme/INSTALL.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/lib/acme/python /usr/local/lib/acme/current/acme.py --daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
User=acme
Group=acme
SupplementaryGroups=acme-web
UMask=0027
RuntimeDirectory=acme
RuntimeDirectoryMode=0750
StateDirectory=acme
StateDirectoryMode=0750
LogsDirectory=acme
LogsDirectoryMode=0750
ReadWritePaths=/var/lib/acme /var/log/acme /etc/acme
# Its own DNS server on 53 (UDP and TCP) and SNMPv3 on 161 bind ports below
# 1024: that privilege, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Environment=MALLOC_ARENA_MAX=2
Nice=-5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK: the network interfaces read - smbclient (backups over SMB)
# stopped without them: "Could not determine network interfaces".
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
